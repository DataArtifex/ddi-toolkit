{% extends "html/base.html.j2" %}

{% block title %}{{ title }}{% endblock %}

{% block content %}
<div class="header-card">
  <span class="badge badge-accent">DDI 4.0 RC1</span>
  {% if agency %}
    <span class="badge">{{ agency }}</span>
  {% endif %}
  <h1>{{ title }}</h1>
  {% if study_id %}
    <p class="subtitle">URN / ID: {{ study_id }}</p>
  {% endif %}
</div>

<div class="grid">
  <div class="stat-card">
    <div class="stat-value">{{ total_fragments }}</div>
    <div class="stat-label">Total Items</div>
  </div>
  <div class="stat-card">
    <div class="stat-value">{{ inventory|length }}</div>
    <div class="stat-label">Item Types</div>
  </div>
</div>

<div class="var-block">
  <h2>Item Type Inventory</h2>
  <table>
    <thead>
      <tr>
        <th>Item Type</th>
        <th>Count</th>
        <th>Share</th>
      </tr>
    </thead>
    <tbody>
      {% for item in inventory %}
      <tr>
        <td><code>{{ item.type }}</code></td>
        <td>{{ item.count }}</td>
        <td>{{ item.share }}%</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
{% endblock %}
