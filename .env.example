# ==============================================================================
# Data Artifex DDI Toolkit - Environment Configuration Example
# Copy this file to .env and adjust the values for your local or remote setup.
# ==============================================================================

# ------------------------------------------------------------------------------
# BaseX XML Database Server Configuration
# ------------------------------------------------------------------------------

# BaseX REST server host (default: localhost)
BASEX_HOST=localhost

# BaseX REST server port (default: 8080)
BASEX_PORT=8080

# BaseX REST endpoint path (default: /rest)
BASEX_PATH=/rest

# BaseX administrator / user credentials (default: admin / admin)
BASEX_USER=admin
BASEX_PASSWORD=admin

# Enable HTTPS/SSL connection (true/false, default: false)
BASEX_USE_SSL=false

# HTTP request timeout in seconds (default: 60.0)
BASEX_TIMEOUT=60.0

# Verify SSL certificates when connecting over HTTPS (true/false, default: true)
BASEX_SSL_VERIFY=true

# Optional: Override the full BaseX REST URL directly (ignores host/port/ssl if set)
# BASEX_URL=http://localhost:8080/rest
